	cpufreq-meson {
		compatible = "amlogic, cpufreq-meson";
		status = "okay";
	};

	saradc@fe026000 {
		compatible = "amlogic,meson-g12a-saradc\0amlogic,meson-saradc";
		status = "okay";
		#io-channel-cells = <0x01>;
		clocks = <0x22 0x09 0x181 0x09 0xc4 0x09 0xc2>;
		clock-names = "clkin\0core\0adc_clk\0adc_sel";
		interrupts = <0x00 0xb5 0x01>;
		reg = <0x00 0xfe026000 0x00 0x48>;
	};

	fixedregulator@vbat {
		compatible = "regulator-fixed";
		regulator-name = "12V";
		regulator-min-microvolt = <0xb71b00>;
		regulator-max-microvolt = <0xb71b00>;
		regulator-boot-on;
		regulator-always-on;
		phandle = <0x23>;
	};

	fixedregulator@vcc5v {
		vin-supply = <0x23>;
		compatible = "regulator-fixed";
		regulator-name = "VCC5V";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		pinctrl-names = "default";
		startup-delay-us = <0x11170>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		apb4@fe000000 {
			compatible = "simple-bus";
			reg = <0x00 0xfe000000 0x00 0x480000>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges = <0x00 0x00 0x00 0xfe000000 0x00 0x480000>;
			status = "okay";

			clock-controller {
				compatible = "amlogic,s5-clkc";
				#clock-cells = <0x01>;
				reg = <0x00 0x00 0x00 0xb54 0x00 0x8000 0x00 0x34c 0x00 0xe040 0x00 0xbc>;
				reg-names = "basic\0pll\0cpu_clk";
				clocks = <0x22>;
				clock-names = "xtal";
				status = "okay";
				phandle = <0x09>;
			};

			meson_clk_msr@48000 {
				compatible = "amlogic,meson-s5-clk-measure";
				reg = <0x00 0x48000 0x00 0x1c>;
				status = "okay";
			};

			watchdog@2100 {
				compatible = "amlogic,meson-sc2-wdt";
				status = "okay";
				amlogic,feed_watchdog_mode = <0x01>;
				reg = <0x00 0x2100 0x00 0x10>;
				clocks = <0x22>;
			};

			pinctrl@4008 {
				compatible = "amlogic,meson-s5-periphs-pinctrl";
				#address-cells = <0x02>;
				#size-cells = <0x02>;
				ranges;
				phandle = <0x24>;

				bank@4008 {
					reg = <0x00 0x4000 0x00 0x8c 0x00 0x4200 0x00 0x26c>;
					reg-names = "mux\0gpio";
					gpio-controller;
					#gpio-cells = <0x02>;
					gpio-ranges = <0x24 0x00 0x00 0x6b>;
					phandle = <0x27>;
				};

				i2c0_pins1 {

					mux {
						groups = "i2c0_scl_d\0i2c0_sda_d";
						function = "i2c0";
						drive-strength-microamp = <0xbb8>;
						bias-disable;
					};
				};

				i2c0_pins2 {

					mux {
						groups = "i2c0_scl_e\0i2c0_sda_e";
						function = "i2c0";
						drive-strength-microamp = <0xbb8>;
						bias-disable;
					};
				};

				i2c1_pins1 {
					phandle = <0x2d>;

					mux {
						groups = "i2c1_scl_a\0i2c1_sda_a";
						function = "i2c1";
						drive-strength-microamp = <0xbb8>;
						bias-disable;
					};
				};

				i2c1_pins2 {

					mux {
						groups = "i2c1_scl_h2\0i2c1_sda_h3";
						function = "i2c1";
						drive-strength-microamp = <0xbb8>;
						bias-disable;
					};
				};

				i2c1_pins3 {

					mux {
						groups = "i2c1_scl_h6\0i2c1_sda_h7";
						function = "i2c1";
						drive-strength-microamp = <0xbb8>;
						bias-disable;
					};
				};

				i2c2_pins1 {

					mux {
						groups = "i2c2_sda_a\0i2c2_scl_a";
						function = "i2c2";
						drive-strength-microamp = <0xbb8>;
						bias-disable;
					};
				};

				i2c2_pins2 {
					phandle = <0x2e>;

