/dts-v1/;

/ {
	model = "Ugoos SK1";
	amlogic-dt-id = "s5_s928x_skybox-8g";
	compatible = "amlogic, s5";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	coreelec;
	coreelec-dt-id = "s5_s928x_ugoos_sk1_8g";

	valhall {
		compatible = "arm,mali-valhall";
		#cooling-cells = <0x02>;
		reg = <0x00 0xfe400000 0x00 0x4000 0x00 0xfe002000 0x00 0x1000>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x110 0x04 0x00 0x111 0x04 0x00 0x10f 0x04>;
		interrupt-names = "GPU\0MMU\0JOB";
		num_of_pp = <0x02>;
		sc_mpp = <0x01>;
		tbl = <0x02 0x03 0x04 0x05 0x06 0x06>;
		status = "okay";
		operating-points-v2 = <0x07>;
		power-domains = <0x08 0x03>;
		system-coherency = <0x1f>;
		clocks = <0x09 0x10d>;
		clock-names = "gpu_mux";
		assigned-clocks = <0x09 0x106 0x09 0x108 0x09 0x10d>;
		assigned-clock-parents = <0x09 0x2f 0x00 0x09 0x108>;
		assigned-clock-rates = <0x00 0x2faf0800 0x00>;
		phandle = <0x6b>;

		clk125_cfg {
			clk_freq = <0x7735940>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			clk_reg = <0xa03>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x1e 0x78>;
		};

		dvfs250_cfg {
			clk_freq = <0xee6b280>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			clk_reg = <0xa01>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x00 0x4c>;
			phandle = <0x02>;
		};

		dvfs285_cfg {
			clk_freq = <0x1107a76d>;
			clk_parent = "fclk_div7";
			clkp_freq = <0x1107a76d>;
			clk_reg = <0xe00>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x00 0x4c>;
		};

		dvfs400_cfg {
			clk_freq = <0x17d78400>;
			clk_parent = "fclk_div5";
			clkp_freq = <0x17d78400>;
			clk_reg = <0xc00>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0x78>;
			phandle = <0x03>;
		};

		dvfs500_cfg {
			clk_freq = <0x1dcd6500>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			clk_reg = <0xa00>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0x78>;
			phandle = <0x04>;
		};

		dvfs666_cfg {
			clk_freq = <0x27bc86aa>;
			clk_parent = "fclk_div3";
			clkp_freq = <0x27bc86aa>;
			clk_reg = <0x800>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0x78>;
			phandle = <0x05>;
		};

		dvfs800_cfg {
			clk_freq = <0x2faf0800>;
			clk_parent = "fclk_div2p5";
			clkp_freq = <0x2faf0800>;
			clk_reg = <0x600>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0xff>;
		};

		dvfs830_cfg {
			clk_freq = <0x326cef80>;
			clk_parent = "sys2_pll";
			clkp_freq = <0x3178cb80>;
			clk_reg = <0x200>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x50 0xff>;
			phandle = <0x06>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0a>;
				};

				core1 {
					cpu = <0x0b>;
				};

				core2 {
					cpu = <0x0c>;
				};

				core3 {
					cpu = <0x0d>;
				};

				core4 {
					cpu = <0x0e>;
				};
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55\0arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x0f 0x10>;
			#cooling-cells = <0x02>;
			clocks = <0x09 0x19 0x09 0x18 0x09 0x01 0x09 0x33 0x09 0x32 0x09 0x17>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent\0dsu_clk\0dsu_pre_parent\0dsu_pre_parent2";
			multi_tables_available;
			operating-points-v2 = <0x11 0x12 0x13 0x14>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x200>;
			dynamic-power-coefficient = <0x400>;
			cpu-supply = <0x15>;
			cpu_supply_external_used;
			dsu-opp-table = <0x124f80 0xd6998 0x16e360 0xe53f8>;
			dsu_clock_shared;
			dsu-low-rate = <0xf4240>;
			dvfs_sibling_core_num = <0x04>;
			dvfs_sibling_cores = <0x00 0x01 0x02 0x03>;
			phandle = <0x0a>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55\0arm,armv8";
			reg = <0x00 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0f 0x10>;
			#cooling-cells = <0x02>;
			clocks = <0x09 0x19 0x09 0x18 0x09 0x01 0x09 0x33 0x09 0x32 0x09 0x17>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent\0dsu_clk\0dsu_pre_parent\0dsu_pre_parent2";
			multi_tables_available;
			operating-points-v2 = <0x11 0x12 0x13 0x14>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x200>;
			dynamic-power-coefficient = <0x400>;
			cpu-supply = <0x15>;
			cpu_supply_external_used;
			dsu-opp-table = <0x124f80 0xd6998 0x16e360 0xe53f8>;
			dsu_clock_shared;
			dsu-low-rate = <0xf4240>;
			dvfs_sibling_core_num = <0x04>;
			dvfs_sibling_cores = <0x00 0x01 0x02 0x03>;
			phandle = <0x0b>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55\0arm,armv8";
			reg = <0x00 0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0f 0x10>;
			#cooling-cells = <0x02>;
			clocks = <0x09 0x19 0x09 0x18 0x09 0x01 0x09 0x33 0x09 0x32 0x09 0x17>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent\0dsu_clk\0dsu_pre_parent\0dsu_pre_parent2";
			multi_tables_available;
			operating-points-v2 = <0x11 0x12 0x13 0x14>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x200>;
			dynamic-power-coefficient = <0x400>;
			cpu-supply = <0x15>;
			cpu_supply_external_used;
			dsu-opp-table = <0x124f80 0xd6998 0x16e360 0xe53f8>;
			dsu_clock_shared;
			dsu-low-rate = <0xf4240>;
			dvfs_sibling_core_num = <0x04>;
			dvfs_sibling_cores = <0x00 0x01 0x02 0x03>;
			phandle = <0x0c>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55\0arm,armv8";
			reg = <0x00 0x03>;
			enable-method = "psci";
			cpu-idle-states = <0x0f 0x10>;
			#cooling-cells = <0x02>;
			clocks = <0x09 0x19 0x09 0x18 0x09 0x01 0x09 0x33 0x09 0x32 0x09 0x17>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent\0dsu_clk\0dsu_pre_parent\0dsu_pre_parent2";
			multi_tables_available;
			operating-points-v2 = <0x11 0x12 0x13 0x14>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x200>;
			dynamic-power-coefficient = <0x400>;
			cpu-supply = <0x15>;
			cpu_supply_external_used;
			dsu-opp-table = <0x124f80 0xd6998 0x16e360 0xe53f8>;
			dsu_clock_shared;
			dsu-low-rate = <0xf4240>;
			dvfs_sibling_core_num = <0x04>;
			dvfs_sibling_cores = <0x00 0x01 0x02 0x03>;
			phandle = <0x0d>;
		};

		cpu@4 {
			device_type = "cpu";
			compatible = "arm,cortex-a76\0arm,armv8";
			reg = <0x00 0x04>;
			enable-method = "psci";
			cpu-idle-states = <0x0f 0x10>;
			#cooling-cells = <0x02>;
			clocks = <0x09 0x31 0x09 0x30 0x09 0x03 0x09 0x33 0x09 0x32 0x09 0x17>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent\0dsu_clk\0dsu_pre_parent\0dsu_pre_parent2";
			multi_tables_available;
			operating-points-v2 = <0x16 0x17 0x18 0x19>;
			voltage-tolerance = <0x00>;
			cpu-supply = <0x1a>;
			dsu-supply = <0x15>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x200>;
			dsu-opp-table = <0x124f80 0xd6998 0x16e360 0xe53f8>;
			dsu_clock_shared;
			dsu-low-rate = <0xf4240>;
			dvfs_sibling_core_num = <0x01>;
			dvfs_sibling_cores = <0x04>;
			phandle = <0x0e>;
		};

		idle-states {
			entry-method = "arm,psci-0.2";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x1f4>;
				exit-latency-us = <0xc8>;
				min-residency-us = <0x1770>;
				phandle = <0x0f>;
			};

			system-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00>;
				entry-latency-us = <0x3fffffff>;
				exit-latency-us = <0x40000000>;
				min-residency-us = <0xffffffff>;
				phandle = <0x10>;
			};
		};
	};

	dsu-pmu-0 {
		compatible = "arm,dsu-pmu";
		status = "disabled";
		cpus = <0x0a 0x0b 0x0c 0x0d 0x0e>;
		interrupts = <0x00 0xe6 0x04>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
	};

	timer_bc {
		reg = <0x00 0xfe0100d8 0x00 0x04 0x00 0xfe0100dc 0x00 0x04>;
		timer_name = "Meson TimerD";
		clockevent-rating = <0x12c>;
		clockevent-shift = <0x14>;
		clockevent-features = <0x23>;
		interrupts = <0x00 0x03 0x01>;
		bit_enable = <0x07>;
		bit_mode = <0x06>;
		bit_resolution = <0x00>;
		resolution_1us = <0x01>;
		min_delta_ns = <0x0a>;
	};

	arm_pmu {
		compatible = "arm,armv8-pmuv3";
		private-interrupts;
		interrupts = <0x00 0xe7 0x04 0x00 0xe8 0x04 0x00 0xe9 0x04 0x00 0xea 0x04 0x00 0xeb 0x04>;
	};

	interrupt-controller@fff01000 {
		compatible = "arm,cortex-a15-gic\0arm,cortex-a9-gic";
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		interrupt-controller;
		reg = <0x00 0xfff01000 0x00 0x1000 0x00 0xfff02000 0x00 0x100>;
		interrupts = <0x01 0x09 0xf04>;
		phandle = <0x01>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	pm {
		compatible = "amlogic, pm";
		status = "okay";
		device_name = "aml_pm";
		extend_resume_reason;
		reg = <0x00 0xfe010288 0x00 0x04 0x00 0xfe0102dc 0x00 0x04>;
	};

	aml_reboot {
		compatible = "aml, reboot";
		sys_reset = <0x84000009>;
		sys_poweroff = <0x84000008>;
		dis_nb_cpus_in_shutdown;
		extend_reboot_reason;
		reg = <0x00 0xfe01037c 0x00 0x04>;
		status = "okay";
	};

	ram-dump {
		compatible = "amlogic, ram_dump";
		status = "okay";
		reg = <0x00 0xfe0102d8 0x00 0x04>;
		reg-names = "SYSCTRL_STICKY_REG6";
		store_device = "data";
	};

	dolby_fw {
		compatible = "amlogic, dolby_fw";
		mem_size = <0x100000>;
		status = "okay";
	};

	secmon {
		compatible = "amlogic, secmon";
		memory-region = <0x1b>;
		in_base_func = <0x82000020>;
		out_base_func = <0x82000021>;
		reserve_mem_size = <0x400000>;
		clear_range = <0x5100000 0x200000>;
	};

	cma_shrinker {
		compatible = "amlogic, cma-shrinker";
		status = "disabled";
		adj = <0x00 0x64 0xc8 0xfa 0x384 0x3b6>;
		free = <0x2000 0x3000 0x4000 0x6000 0x7000 0x8000>;
	};

	xtal-clk {
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "xtal";
		#clock-cells = <0x00>;
		phandle = <0x22>;
	};

	cpu_info {
		compatible = "amlogic, cpuinfo";
		status = "okay";
		cpuinfo_cmd = <0x82000044>;
	};

	rtc@0xfe010288 {
		compatible = "amlogic,meson-vrtc";
		reg = <0x00 0xfe010288 0x00 0x04>;
		status = "okay";
		mboxes = <0x1c 0x01>;
	};

	power-domains {
		compatible = "amlogic,s5-power-domain";
		#power-domain-cells = <0x01>;
		status = "okay";
		phandle = <0x08>;
	};

	adla@0xfe371000 {
		compatible = "amlogic,adla";
		dev_name = "adla";
		status = "okay";
		reg = <0x00 0xfe371000 0x00 0x2000 0x00 0xf7038000 0x00 0x40000>;
		reg-names = "adla_reg\0adla_sram";
		interrupt-names = "adla";
		interrupts = <0x00 0x94 0x01>;
		clocks = <0x09 0xef>;
		clock-names = "adla_core_clk";
		assigned-clocks = <0x09 0xef>;
		assigned-clock-parentsd = <0x09 0x11>;
		assigned-clock-rates = <0x2faf0800>;
		power-domains = <0x08 0x1a>;
		nn_hw_version = "r1p0";
		smmu;
		nn_regulator = "pwm_regulator";
	};

	nna_top_ports_wrapper@fe370000 {
		compatible = "amazon,nna-1.0";
		device-name = "acenna0";
		status = "disabled";
		interrupt-names = "nna_interrupt";
		interrupts = <0x00 0x94 0x01>;
		minor-number = <0x00>;
		reg = <0x00 0xfe370000 0x00 0x1000>;
		reg-names = "nna_irq_wrapper";
	};

	nna_top_ports_wrapper@fe371000 {
		compatible = "amazon,nna-1.0";
		device-name = "acenna1";
		status = "disabled";
		interrupt-names = "nna_interrupt";
		interrupts = <0x00 0x95 0x01>;
		minor-number = <0x01>;
		reg = <0x00 0xfe371000 0x00 0x1000>;
		reg-names = "nna_irq_wrapper";
	};

	nna_top_ports_wrapper@fe372000 {
		compatible = "amazon,nna-1.0";
		device-name = "acenna2";
		status = "disabled";
		interrupt-names = "nna_interrupt";
		interrupts = <0x00 0x96 0x01>;
		minor-number = <0x02>;
		reg = <0x00 0xfe372000 0x00 0x1000>;
		reg-names = "nna_irq_wrapper";
	};

	nna_top_ports_wrapper@fe373000 {
		compatible = "amazon,nna-1.0";
		device-name = "acenna3";
		status = "disabled";
		interrupt-names = "nna_interrupt";
		interrupts = <0x00 0x97 0x01>;
		minor-number = <0x03>;
		reg = <0x00 0xfe373000 0x00 0x1000>;
		reg-names = "nna_irq_wrapper";
	};

	nna_top_ports_wrapper@fe374000 {
		compatible = "amazon,nna-1.0";
		device-name = "acenna4";
		status = "disabled";
		interrupt-names = "nna_interrupt";
		interrupts = <0x00 0x98 0x01>;
		minor-number = <0x04>;
		reg = <0x00 0xfe374000 0x00 0x1000>;
		reg-names = "nna_irq_wrapper";
	};

	nna_top_ports_wrapper@fe375000 {
		compatible = "amazon,nna-1.0";
		device-name = "acenna5";
		status = "disabled";
		interrupt-names = "nna_interrupt";
		interrupts = <0x00 0x99 0x01>;
		minor-number = <0x05>;
		reg = <0x00 0xfe375000 0x00 0x1000>;
		reg-names = "nna_irq_wrapper";
	};

	jtag {
		compatible = "amlogic, jtag";
		status = "disabled";
		select = "disable";
		pinctrl-names = "jtag_a_pins\0jtag_b_pins";
		pinctrl-0 = <0x1d>;
		pinctrl-1 = <0x1e>;
	};

	hifi4dsp {
		compatible = "amlogic, hifi4dsp";
		memory-region = <0x1f>;
		reg = <0x00 0xfe340018 0x00 0x114 0x00 0xfe350018 0x00 0x114 0x00 0xfe010258 0x00 0x04 0x00 0xfe01025c 0x00 0x04 0x00 0x30820000 0x00 0x80000>;
		dsp-monitor-period-ms = <0x3e8>;
		reg-names = "dspa_top_reg\0dspb_top_reg";
		dsp-start-mode = <0x01>;
		dsp-cnt = <0x02>;
		dspaoffset = <0x00>;
		dspboffset = <0x800000>;
		bootlocation = <0x01>;
		boot_sram_addr = <0xfff00000>;
		boot_sram_size = <0x80000>;
		status = "disabled";
	};

	pwm_cd-regulator {
		compatible = "pwm-regulator";
		pwms = <0x20 0x01 0x5dc 0x00>;
		regulator-name = "vddcpua";
		regulator-min-microvolt = <0xa8368>;
		regulator-max-microvolt = <0x1001a8>;
		regulator-always-on;
		max-duty-cycle = <0x5dc>;
		voltage-table = <0x1001a8 0x00 0xfda98 0x03 0xfb388 0x06 0xf8c78 0x09 0xf6568 0x0c 0xf3e58 0x0e 0xf1748 0x11 0xef038 0x14 0xec928 0x17 0xea218 0x1a 0xe7b08 0x1d 0xe53f8 0x1f 0xe2ce8 0x22 0xe05d8 0x25 0xddec8 0x28 0xdb7b8 0x2b 0xd90a8 0x2d 0xd6998 0x30 0xd4288 0x33 0xd1b78 0x36 0xcf468 0x38 0xccd58 0x3b 0xca648 0x3e 0xc7f38 0x41 0xc5828 0x44 0xc3118 0x46 0xc0a08 0x49 0xbe2f8 0x4c 0xbbbe8 0x4f 0xb94d8 0x51 0xb6dc8 0x54 0xb46b8 0x57 0xb1fa8 0x59 0xaf898 0x5c 0xad188 0x5f 0xaaa78 0x62 0xa8368 0x64>;
		status = "okay";
		phandle = <0x15>;
	};

	pwm_ab-regulator {
		compatible = "pwm-regulator";
		pwms = <0x21 0x00 0x5dc 0x00>;
		regulator-name = "vddcpub";
		regulator-min-microvolt = <0xa8368>;
		regulator-max-microvolt = <0x1001a8>;
		regulator-always-on;
		max-duty-cycle = <0x5dc>;
		voltage-table = <0x1001a8 0x00 0xfda98 0x03 0xfb388 0x06 0xf8c78 0x09 0xf6568 0x0c 0xf3e58 0x0e 0xf1748 0x11 0xef038 0x14 0xec928 0x17 0xea218 0x1a 0xe7b08 0x1d 0xe53f8 0x1f 0xe2ce8 0x22 0xe05d8 0x25 0xddec8 0x28 0xdb7b8 0x2b 0xd90a8 0x2d 0xd6998 0x30 0xd4288 0x33 0xd1b78 0x36 0xcf468 0x38 0xccd58 0x3b 0xca648 0x3e 0xc7f38 0x41 0xc5828 0x44 0xc3118 0x46 0xc0a08 0x49 0xbe2f8 0x4c 0xbbbe8 0x4f 0xb94d8 0x51 0xb6dc8 0x54 0xb46b8 0x57 0xb1fa8 0x59 0xaf898 0x5c 0xad188 0x5f 0xaaa78 0x62 0xa8368 0x64>;
		status = "okay";
		phandle = <0x1a>;
	};

	a76_opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x16>;

