						groups = "i2c2_scl_t\0i2c2_sda_t";
						function = "i2c2";
						drive-strength-microamp = <0xbb8>;
						bias-disable;
					};
				};

				i2c2_pins3 {

					mux {
						groups = "i2c2_scl_x\0i2c2_sda_x";
