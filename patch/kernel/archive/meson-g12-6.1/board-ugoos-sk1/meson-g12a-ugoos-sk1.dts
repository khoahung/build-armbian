				i2c5_pins3 {

					mux {
						groups = "i2c5_sda_a\0i2c5_scl_a";
						function = "i2c5";
						drive-strength-microamp = <0xbb8>;
						bias-disable;
					};
				};

				a_uart1 {

					mux {
						groups = "uart_a_tx_d\0uart_a_rx_d";
						function = "uart_a";
					};
				};

				a_uart2 {

					mux {
						groups = "uart_a_tx_c\0uart_a_rx_c";
						function = "uart_a";
					};
				};

				b_uart {
					phandle = <0x31>;

					mux {
						groups = "uart_b_tx\0uart_b_rx\0uart_b_cts\0uart_b_rts";
						bias-pull-up;
						output-high;
						function = "uart_b";
					};
				};

				c_uart1 {
					phandle = <0x51>;

					mux {
						groups = "uart_c_tx_a\0uart_c_rx_a";
						function = "uart_c";
					};
				};

				c_uart2 {

					mux {
						groups = "uart_c_tx_d\0uart_c_rx_d";
						function = "uart_c";
					};
				};

				c_uart3 {

					mux {
						groups = "uart_c_tx_h\0uart_c_rx_h\0uart_c_cts_h\0uart_c_rts_h";
						bias-pull-up;
						output-high;
						function = "uart_c";
					};
				};

				d_uart {
					phandle = <0x52>;

					mux {
						groups = "uart_d_tx\0uart_d_rx";
						function = "uart_d";
					};
				};

				e_uart {
					phandle = <0x53>;

					mux {
						groups = "uart_e_tx\0uart_e_rx";
						function = "uart_e";
					};
				};

				f_uart {
					phandle = <0x54>;

					mux {
						groups = "uart_f_tx\0uart_f_rx";
						function = "uart_f";
					};
				};

				sd_to_ao_uart_clr_pins {
					phandle = <0x47>;

					mux {
