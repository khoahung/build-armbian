		disable_port = <0x00>;
		reg = <0x00 0x00 0x00 0x00 0x00 0xff63c000 0x00 0x2000 0x00 0xffe0d000 0x00 0x2000 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xfe398000 0x00 0x18000 0x00 0xfe000000 0x00 0x1fff>;
	};

	auge_sound {
		compatible = "amlogic, auge-sound-card";
		aml-audio-card,name = "AML-AUGESOUND";
		avout_mute-gpios = <0x27 0x66 0x00>;
		interrupts = <0x00 0x53 0x01>;
		interrupt-names = "audio_exception64";

		aml-audio-card,dai-link@0 {
			mclk-fs = <0x80>;

			cpu {
				sound-dai = <0xb0>;
				system-clock-frequency = <0x5dc000>;
			};

			codec {
				sound-dai = <0xb0>;
			};
		};

		aml-audio-card,dai-link@1 {
			format = "i2s";
			mclk-fs = <0x100>;
			bitclock-master = <0xb1>;
			frame-master = <0xb1>;

			cpu {
				sound-dai = <0xb1>;
				dai-tdm-slot-tx-mask = <0x01 0x01>;
				dai-tdm-slot-rx-mask = <0x01 0x01>;
				dai-tdm-slot-num = <0x02>;
				dai-tdm-slot-width = <0x20>;
				system-clock-frequency = <0xbb8000>;
			};

			codec {
				sound-dai = <0xb2>;
			};
		};

		aml-audio-card,dai-link@2 {
			mclk-fs = <0x80>;

			cpu {
				sound-dai = <0xb3>;
				system-clock-frequency = <0x5dc000>;
			};

			codec {
				sound-dai = <0xb3>;
			};
		};

		aml-audio-card,dai-link@3 {
			format = "i2s";
			mclk-fs = <0x100>;
			bitclock-master = <0xb4>;
			frame-master = <0xb4>;

			cpu {
				sound-dai = <0xb4>;
				dai-tdm-slot-tx-mask = <0x01 0x01>;
				dai-tdm-slot-rx-mask = <0x01 0x01>;
				dai-tdm-slot-num = <0x02>;
				dai-tdm-slot-width = <0x20>;
				system-clock-frequency = <0xbb8000>;
			};

			codec {
				sound-dai = <0xb5>;
			};
		};
	};

